<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tiny11 Studio" Width="820" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e" FontFamily="Segoe UI"
        MinWidth="700" MinHeight="550">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#181825" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="cmbLanguage" Width="100" Background="#313244"
                              Foreground="#cdd6f4" FontSize="11" BorderThickness="0"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="txtTitle" Text="tiny11 Studio" Foreground="#89b4fa"
                               FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSubtitle" Text="Modular Windows 11 Image Builder"
                               Foreground="#a6adc8" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Padding="0,4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
                <Border x:Name="stepDot1" Width="32" Height="32" CornerRadius="16" Background="#89b4fa" Margin="0,0,4,0">
                    <TextBlock Text="1" Foreground="#1e1e2e" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="stepLine1" Width="40" Height="2" Background="#45475a" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border x:Name="stepDot2" Width="32" Height="32" CornerRadius="16" Background="#45475a" Margin="0,0,4,0">
                    <TextBlock Text="2" Foreground="#a6adc8" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="stepLine2" Width="40" Height="2" Background="#45475a" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border x:Name="stepDot3" Width="32" Height="32" CornerRadius="16" Background="#45475a" Margin="0,0,4,0">
                    <TextBlock Text="3" Foreground="#a6adc8" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="stepLine3" Width="40" Height="2" Background="#45475a" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Border x:Name="stepDot4" Width="32" Height="32" CornerRadius="16" Background="#45475a" Margin="0,0,4,0">
                    <TextBlock Text="4" Foreground="#a6adc8" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <!-- Submodule Prompt -->
            <StackPanel x:Name="submodulePanel" Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Visibility="Collapsed">
                <TextBlock Text="Scripts Not Found" Foreground="#cdd6f4" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="tiny11 Studio needs the tiny11builder scripts. Choose how to set them up:" Foreground="#a6adc8" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,20"/>
                <Button x:Name="btnCloneGithub" Content="Clone from GitHub (recommended)" Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold" Padding="16,10" Margin="0,0,0,8" Cursor="Hand" BorderThickness="0"/>
                <Button x:Name="btnUseLocal" Content="Use local copy..." Background="#313244" Foreground="#cdd6f4" Padding="16,8" Cursor="Hand" BorderThickness="0"/>
                <TextBlock x:Name="txtSubmoduleStatus" Text="" Foreground="#a6adc8" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
            <!-- Step 1: Source -->
            <StackPanel x:Name="step1Panel" Margin="20">
                <TextBlock Text="Source Configuration" Foreground="#cdd6f4" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Configure your Windows 11 ISO source and output paths" Foreground="#a6adc8" FontSize="13" Margin="0,0,0,20"/>
                <TextBlock Text="Windows 11 ISO File" Foreground="#a6adc8" FontSize="12" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,16">
                    <Button x:Name="btnBrowseIso" Content="Browse..." DockPanel.Dock="Right" Background="#313244" Foreground="#cdd6f4" Padding="16,8" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                    <TextBox x:Name="txtIsoPath" Background="#313244" Foreground="#cdd6f4" Padding="10,8" BorderBrush="#45475a" BorderThickness="1" IsReadOnly="True" Text="Select a Windows 11 ISO file..."/>
                </DockPanel>
                <TextBlock Text="Select Edition" Foreground="#a6adc8" FontSize="12" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbEdition" Background="#313244" Foreground="#cdd6f4" Padding="10,8" BorderBrush="#45475a" BorderThickness="1" Margin="0,0,0,16" IsEnabled="False"/>
                <TextBlock Text="Scratch Directory" Foreground="#a6adc8" FontSize="12" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,16">
                    <Button x:Name="btnBrowseScratch" Content="Browse..." DockPanel.Dock="Right" Background="#313244" Foreground="#cdd6f4" Padding="16,8" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                    <TextBox x:Name="txtScratchDir" Background="#313244" Foreground="#cdd6f4" Padding="10,8" BorderBrush="#45475a" BorderThickness="1"/>
                </DockPanel>
                <TextBlock Text="Output ISO Path" Foreground="#a6adc8" FontSize="12" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,16">
                    <Button x:Name="btnBrowseOutput" Content="Browse..." DockPanel.Dock="Right" Background="#313244" Foreground="#cdd6f4" Padding="16,8" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                    <TextBox x:Name="txtOutputPath" Background="#313244" Foreground="#cdd6f4" Padding="10,8" BorderBrush="#45475a" BorderThickness="1" Text="tiny11.iso"/>
                </DockPanel>
            </StackPanel>
            <!-- Step 2: Build Mode -->
            <StackPanel x:Name="step2Panel" Margin="20" Visibility="Collapsed">
                <TextBlock Text="Build Mode" Foreground="#cdd6f4" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Choose how aggressively to trim your Windows image" Foreground="#a6adc8" FontSize="13" Margin="0,0,0,20"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="cardRegular" Grid.Column="0" Background="#313244" CornerRadius="8" Padding="20" BorderThickness="2" BorderBrush="#94e2d5" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Regular" Foreground="#94e2d5" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Serviceable" Foreground="#a6adc8" FontSize="12" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#cdd6f4" FontSize="12" Margin="0,0,0,8" Text="Removes bloatware while keeping the system fully updateable. Windows Update, Defender, and WinSxS remain intact."/>
                            <TextBlock Text="Recommended for daily use" Foreground="#a6e3a1" FontSize="11" FontStyle="Italic"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="cardCore" Grid.Column="2" Background="#313244" CornerRadius="8" Padding="20" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Core" Foreground="#cba6f7" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="Maximum Reduction" Foreground="#a6adc8" FontSize="12" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#cdd6f4" FontSize="12" Margin="0,0,0,8" Text="Removes everything including WinSxS, Defender, and Windows Update. Smallest possible image."/>
                            <Border Background="#45475a" CornerRadius="4" Padding="8,4" Margin="0,4,0,0">
                                <TextBlock Text="Non-serviceable! For VMs and testing only." Foreground="#f38ba8" FontSize="11" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <!-- Step 3: Install Type -->
            <Grid x:Name="step3Panel" Margin="20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Installation Type" Foreground="#cdd6f4" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Choose standard removals or customize each item" Foreground="#a6adc8" FontSize="13" Margin="0,0,0,16"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="cardStandard" Grid.Column="0" Background="#313244" CornerRadius="8" Padding="12" BorderThickness="2" BorderBrush="#89b4fa" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Standard" Foreground="#89b4fa" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Apply recommended removals" Foreground="#a6adc8" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="cardCustom" Grid.Column="2" Background="#313244" CornerRadius="8" Padding="12" BorderThickness="2" BorderBrush="Transparent" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="Custom" Foreground="#cdd6f4" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Choose what to keep and remove" Foreground="#a6adc8" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid x:Name="customPanel" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="btnSelectAll" Content="Select All" Background="#313244" Foreground="#cdd6f4" Padding="12,6" Margin="4,0" Cursor="Hand" BorderThickness="0"/>
                            <Button x:Name="btnDeselectAll" Content="Deselect All" Background="#313244" Foreground="#cdd6f4" Padding="12,6" Margin="4,0" Cursor="Hand" BorderThickness="0"/>
                            <Button x:Name="btnLoadProfile" Content="Load Profile" Background="#313244" Foreground="#cdd6f4" Padding="12,6" Margin="4,0" Cursor="Hand" BorderThickness="0"/>
                            <Button x:Name="btnSaveProfile" Content="Save Profile" Background="#313244" Foreground="#cdd6f4" Padding="12,6" Margin="4,0" Cursor="Hand" BorderThickness="0"/>
                        </StackPanel>
                        <TextBox x:Name="txtSearch" Background="#313244" Foreground="#cdd6f4" Padding="10,6" BorderBrush="#45475a" BorderThickness="1" Margin="0,0,8,0"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#313244" CornerRadius="8" Padding="4">
                            <ListBox x:Name="lstCategories" Background="Transparent" BorderThickness="0" Foreground="#cdd6f4" FontSize="13"/>
                        </Border>
                        <Border Grid.Column="2" Background="#313244" CornerRadius="8" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="pnlItems"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,8,0,0" Background="#313244" CornerRadius="6" Padding="12,6">
                        <TextBlock x:Name="txtItemCount" Text="0 items selected for removal" Foreground="#a6adc8" FontSize="12"/>
                    </Border>
                </Grid>
            </Grid>
            <!-- Step 4: Build -->
            <Grid x:Name="step4Panel" Margin="20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Build" Foreground="#cdd6f4" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Review your configuration and start the build" Foreground="#a6adc8" FontSize="13" Margin="0,0,0,16"/>
                </StackPanel>
                <Border Grid.Row="1" Background="#313244" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Source" Foreground="#a6adc8" FontSize="11"/>
                            <TextBlock x:Name="txtSummarySource" Text="-" Foreground="#cdd6f4" FontSize="13" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Mode" Foreground="#a6adc8" FontSize="11"/>
                            <TextBlock x:Name="txtSummaryMode" Text="Regular" Foreground="#94e2d5" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Output" Foreground="#a6adc8" FontSize="11"/>
                            <TextBlock x:Name="txtSummaryOutput" Text="-" Foreground="#cdd6f4" FontSize="13" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Items to Remove" Foreground="#a6adc8" FontSize="11"/>
                            <TextBlock x:Name="txtSummaryCount" Text="0" Foreground="#f9e2af" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="txtPhase" Text="Ready to build" Foreground="#a6adc8" FontSize="12"/>
                        <TextBlock x:Name="txtPercent" Text="" Foreground="#89b4fa" FontSize="12" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <ProgressBar x:Name="progressBar" Background="#313244" Foreground="#89b4fa" Height="8" Minimum="0" Maximum="100" Value="0"/>
                </StackPanel>
                <Border Grid.Row="3" Background="#181825" CornerRadius="8" Padding="8" Margin="0,4,0,0">
                    <TextBox x:Name="txtLog" Background="Transparent" Foreground="#a6adc8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0"/>
                </Border>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="btnStartBuild" Content="Start Build" Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold" Padding="32,12" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                    <Button x:Name="btnCancelBuild" Content="Cancel" IsEnabled="False" Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold" Padding="16,8" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                    <Button x:Name="btnOpenFolder" Content="Open Output Folder" Visibility="Collapsed" Background="#313244" Foreground="#cdd6f4" Padding="16,8" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="#181825" Padding="16,10">
            <DockPanel x:Name="navBar">
                <Button x:Name="btnBack" Content="Back" DockPanel.Dock="Left" Visibility="Collapsed" Background="#313244" Foreground="#cdd6f4" Padding="16,8" Cursor="Hand" BorderThickness="0"/>
                <Button x:Name="btnNext" Content="Next" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold" Padding="20,10" Cursor="Hand" BorderThickness="0"/>
                <TextBlock Text="" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
